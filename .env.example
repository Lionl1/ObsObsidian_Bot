TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_USER_ID=123456789
OPENAI_API_KEY=local
# local run: http://127.0.0.1:8000/v1
# docker run: http://host.docker.internal:8000/v1
OPENAI_BASE_URL=http://host.docker.internal:8000/v1
OPENAI_MODEL=qwen2.5-14b-instruct
HOST_OBSIDIAN_PATH=/absolute/path/to/your/ObsidianVault/Inbox
CONTAINER_OBSIDIAN_PATH=/app/vault
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/ObsidianVault/Inbox
ARTICLE_TEXT_LIMIT=15000
ATTACHMENT_TEXT_LIMIT=15000
TELEGRAM_FILE_MAX_SIZE=10485760
URL_EXTRACT_LIMIT=3
HISTORY_LIMIT=2
OPENAI_TIMEOUT_SECONDS=10
OBSIDIAN_PROMPT_NOTES_LIMIT=10
OBSIDIAN_NOTE_CONTENT_LIMIT=12000
# macOS example: UID=501, GID=20
# Linux example: UID=1000, GID=1000
UID=501
GID=20
